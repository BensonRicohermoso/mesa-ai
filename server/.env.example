PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Customer-facing base URL for QR code generation and CORS.
# Set this to your LAN IP (for local phone QR testing) or deployed frontend URL.
# Examples:
#   CLIENT_URL=http://192.168.1.100:5173   (local LAN)
#   CLIENT_URL=https://mesa.yourdomain.com (production)
CLIENT_URL=http://localhost:5173

ORDER_EXPIRY_MINUTES=20
